OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional Docker outbound proxy. Leave empty for a direct connection.
ADAN_PROXY_URL=
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# Cross-encoder reranker disabled by default (saves ~1.4s per query)
ENABLE_RERANKER=false
ROUTER_MODEL=baseten/mammoth-1:free
TEXT_MODEL=nvidia/nemotron-3.5-lightning:free
# Explicit fallback if the configured routing model is unavailable.
ROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
DATABASE_PATH=data/database/app.db
DOCUMENTS_PATH=data/documents
# Local Qdrant served via docker-compose on port 6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_policies
QDRANT_LOCAL_PATH=.cache/adan/qdrant_hybrid
TOP_K=5
REQUEST_TIMEOUT_SECONDS=120
MODEL_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=20
MAX_TOOL_CALLS=24
MAX_GENERATOR_TURNS=12
MAX_DOCUMENT_FOLLOWUPS=2
MAX_DATABASE_FOLLOWUPS=2
MAX_CORRECTIONS=2
TRANSIENT_RETRIES=1
# Optional; tracing is off unless explicitly enabled and configured.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=adan
RETRIEVAL_CANDIDATES=20
RERANK_TOP_N=5
