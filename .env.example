OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_MODEL=baseten/mammoth-1:free
TEXT_MODEL=nvidia/nemotron-3.5-super-vl:free
# Explicit fallback if the configured routing model is unavailable.
ROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
DATABASE_PATH=data/database/app.db
DOCUMENTS_PATH=data/documents
INDEX_PATH=.cache/adan/qdrant
EMBEDDING_CACHE_PATH=.cache/adan/embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Empty uses embedded Qdrant; set URL to use a Qdrant server instead.
QDRANT_URL=
TOP_K=5
REQUEST_TIMEOUT_SECONDS=120
MODEL_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=20
MAX_TOOL_CALLS=24
MAX_GENERATOR_TURNS=12
MAX_DOCUMENT_FOLLOWUPS=2
MAX_DATABASE_FOLLOWUPS=2
MAX_CORRECTIONS=2
TRANSIENT_RETRIES=1
# Optional; tracing is off unless explicitly enabled and configured.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=adan
